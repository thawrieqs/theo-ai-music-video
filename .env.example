# Server-only secrets: configure these in the hosting provider's Environment Variables.
FAL_KEY=isi_key_fal_kamu
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ganti_dengan_key_kamu
SUPABASE_SERVICE_ROLE_KEY=ISI_SECRET_KEY_SERVER_ONLY

# Optional: only needed for video-reference mode
ANTHROPIC_API_KEY=

# Optional model settings
FAL_MODEL=fal-ai/ltx-2.3/image-to-video/fast
FAL_EXTRA_INPUT={"fps":25}
PORT=3000
